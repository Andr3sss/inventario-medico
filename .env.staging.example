# Valores publicos del GitHub Environment "staging". No usar el proyecto productivo.
CREARCOS_DEPLOY_ENV=staging
PUBLIC_APP_URL=https://staging.inventario.empresa.example
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_ENABLE_LOCAL_DEMO=false
VITE_LOCAL_DEMO_PASSWORD=
AUTH_REDIRECT_URL=https://staging.inventario.empresa.example/actualizar-contrasena
ALLOWED_ORIGINS=https://staging.inventario.empresa.example
SUPABASE_PROJECT_ID=PROJECT_REF
CLOUDFLARE_PAGES_PROJECT=crearcos-inventario

# Guardar como secretos del Environment, nunca en este archivo:
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
