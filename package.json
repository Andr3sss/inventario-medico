{
  "name": "crearcos-inventario",
  "private": true,
  "version": "0.0.1",
  "description": "Prototipo de inventario medico/quirurgico offline-first para Crearcos",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "seeds"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:e2e:sync": "node -e \"if(process.env.CREARCOS_E2E_SUPABASE_LOCAL!=='true')throw new Error('CREARCOS_E2E_SUPABASE_LOCAL=true es obligatorio')\" && vitest run packages/data/src/e2e/multidispositivo.supabase.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "security:secrets": "node scripts/security/check-secrets.mjs",
    "format": "prettier --write .",
    "seed": "tsx seeds/src/cli.ts",
    "verificar": "npm run security:secrets && npm run lint && npm run typecheck && npm run test",
    "dev": "npm run dev --workspace @crearcos/web",
    "build": "npm run build --workspace @crearcos/web",
    "supabase:bootstrap:demo": "node scripts/supabase/bootstrap-demo.mjs",
    "supabase:bootstrap:production": "node scripts/supabase/bootstrap-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.4.2",
    "supabase": "2.117.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
