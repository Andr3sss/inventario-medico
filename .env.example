# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase.
# Nunca subas .env.local a Git.

# URL base del proyecto Supabase (sin /rest/v1 ni rutas adicionales)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clave publicable del proyecto (visible en Project Settings → API → Publishable key)
# Solo esta clave puede empezar por VITE_. Nunca uses la service_role aquí.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Demo local aislado (solo para desarrollo sin Supabase). Mantener false en producción.
VITE_ENABLE_LOCAL_DEMO=false
VITE_LOCAL_DEMO_PASSWORD=

# Scripts de operador — solo en .env.local, nunca en Git
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Functions: orígenes HTTPS exactos permitidos, separados por coma
ALLOWED_ORIGINS=

# Bootstrap de entorno de demo
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_NAME=Administrador Demo
DEMO_ADMIN_PASSWORD=

# Bootstrap de entorno UAT
UAT_USER_PASSWORD=

# Bootstrap de producción (solo después del handoff irreversible)
PRODUCTION_ADMIN_EMAIL=admin@empresa.example
PRODUCTION_ADMIN_NAME=Administrador Principal
PRODUCTION_ADMIN_PASSWORD=
