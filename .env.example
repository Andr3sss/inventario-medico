# Navegador: solo la clave publishable es pública; service_role nunca usa VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_LOCAL_DEMO=false
VITE_LOCAL_DEMO_PASSWORD=

# Scripts de operador. Completar únicamente en .env.local o en el gestor de secretos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Functions: orígenes exactos y única ruta de invitación/recuperación.
ALLOWED_ORIGINS=
AUTH_REDIRECT_URL=

# Bootstrap demo explícito.
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_NAME=Administrador Demo
DEMO_ADMIN_PASSWORD=

# Bootstrap posterior al handoff.
PRODUCTION_ADMIN_EMAIL=admin@empresa.example
PRODUCTION_ADMIN_NAME=Administrador Principal
PRODUCTION_REDIRECT_URL=
