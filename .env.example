# Navegador: solo la clave publishable es publica; service_role nunca usa VITE_.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_ENABLE_LOCAL_DEMO=false
VITE_LOCAL_DEMO_PASSWORD=

# Scripts de operador. Mantener estos valores exclusivamente en un gestor de secretos.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# Bootstrap demo explicito.
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_NAME=Administrador Demo
DEMO_ADMIN_PASSWORD=

# Bootstrap posterior al handoff.
PRODUCTION_ADMIN_EMAIL=admin@empresa.example
PRODUCTION_ADMIN_NAME=Administrador Principal
PRODUCTION_REDIRECT_URL=https://inventario.empresa.example
